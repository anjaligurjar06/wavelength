# Copy to .env for local dev. In Railway, set these as service variables instead.
# Never commit a real .env.

# --- Spotify (from the Spotify Developer Dashboard) ---
SPOTIFY_CLIENT_ID=your-client-id
SPOTIFY_CLIENT_SECRET=your-client-secret
# Must EXACTLY match a Redirect URI registered in the Spotify dashboard
# local:   http://127.0.0.1:8000/auth/spotify/callback
# staging: https://<your-api-domain>/auth/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback

# --- Auth ---
# generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# --- Database ---
# Railway gives postgresql://... ; the app and alembic need the +psycopg driver prefix
DATABASE_URL=postgresql+psycopg://wavelength:wavelength@localhost:5432/wavelength

# --- CORS ---
# Where the Spotify callback sends the browser after login (token in the query string)
# and the CORS origin. With no frontend, point it at the API itself (pages.py serves /auth/callback).
# local:   http://127.0.0.1:8000
# staging: https://<your-api-domain>
FRONTEND_URL=http://127.0.0.1:8000

# --- Redis (matching/score cache) ---
# Not in config.py yet, see DEPLOY.md before relying on this
REDIS_URL=redis://localhost:6379/0
